{
  "expo": {
    "name": "Sorloo",
    "slug": "weeko",
    "version": "1.2.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "sorloo",
    "userInterfaceStyle": "automatic",
    "ios": {
      "bundleIdentifier": "com.getweeko.app",
      "supportsTablet": false,
      "config": {
        "usesNonExemptEncryption": false
      },
      "infoPlist": {
        "CFBundleAllowMixedLocalizations": true
      }
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#1E6B52",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "package": "com.sorloo.app"
    },
    "web": {
      "output": "single",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-camera",
        {
          "cameraPermission": "Sorloo utilise l'appareil photo pour scanner les codes-barres, photographier tes repas et, si tu le souhaites, prendre tes photos de progression.",
          "microphonePermission": false,
          "recordAudioAndroid": false
        }
      ],
      [
        "@kingstinct/react-native-healthkit",
        {
          "NSHealthShareUsageDescription": "Sorloo lit tes pas, tes pesées et tes entraînements pour suivre ton objectif de pas, ta courbe de poids et cocher tes séances.",
          "NSHealthUpdateUsageDescription": "Sorloo n'enregistre rien dans Santé : l'app lit uniquement tes pas, tes pesées et tes entraînements pour ton suivi.",
          "background": false
        }
      ],
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#1E6B52",
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 120
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "Sorloo accède à tes photos uniquement quand tu choisis une photo de repas ou de progression.",
          "cameraPermission": "Sorloo utilise l'appareil photo pour scanner les codes-barres, photographier tes repas et, si tu le souhaites, prendre tes photos de progression.",
          "microphonePermission": false
        }
      ],
      [
        "expo-notifications",
        {
          "color": "#1E6B52"
        }
      ],
      "expo-localization",
      "expo-secure-store",
      "expo-web-browser"
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "eas": {
        "projectId": "04a8bf82-f7f5-4f51-835a-f99d4405ef8d"
      }
    },
    "runtimeVersion": {
      "policy": "appVersion"
    },
    "updates": {
      "url": "https://u.expo.dev/04a8bf82-f7f5-4f51-835a-f99d4405ef8d",
      "checkAutomatically": "ON_LOAD",
      "fallbackToCacheTimeout": 0
    },
    "locales": {
      "fr": "./locales/fr.json",
      "en": "./locales/en.json",
      "de": "./locales/de.json",
      "es": "./locales/es.json",
      "it": "./locales/it.json",
      "pt": "./locales/pt.json"
    }
  }
}
