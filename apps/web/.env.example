# ---- Obligatoires -------------------------------------------------------
# MongoDB Atlas (cluster en région Europe). Exemple :
# mongodb+srv://weeko:<motdepasse>@cluster0.xxxxx.mongodb.net/?retryWrites=true&w=majority
MONGODB_URI=
MONGODB_DB=weeko

# URL publique du site (sans / final), ex. https://getweeko.com
NEXT_PUBLIC_APP_URL=
BETTER_AUTH_URL=
# Secret de session : openssl rand -base64 32
BETTER_AUTH_SECRET=
# Clé de chiffrement des données de santé (32 octets en base64) : openssl rand -base64 32
# À conserver précieusement : sans elle, les données de santé ne sont plus lisibles.
HEALTH_DATA_KEY=

# ---- Paiement (Stripe) ---------------------------------------------------
STRIPE_SECRET_KEY=
# Clé publiable (pk_test_… / pk_live_…) : affiche le formulaire de paiement sur le site
STRIPE_PUBLISHABLE_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_MONTHLY=
STRIPE_PRICE_YEARLY=
# Jours d'essai gratuit (0 = pas d'essai)
STRIPE_TRIAL_DAYS=0

# ---- Coach IA (Claude) ---------------------------------------------------
ANTHROPIC_API_KEY=
# Facultatif, modèle par défaut : claude-opus-5-5
ANTHROPIC_MODEL=

# ---- Photos de recettes (Pexels) -----------------------------------------
PEXELS_API_KEY=
# Secret partagé avec Vercel Cron : openssl rand -hex 24
CRON_SECRET=

# ---- E-mails (Resend), facultatif ----------------------------------------
RESEND_API_KEY=
EMAIL_FROM=Weeko <noreply@getweeko.com>

# ---- Connexion Google, facultatif ----------------------------------------
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
